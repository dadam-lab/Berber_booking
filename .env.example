# Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail Nodemailer Email Service Configuration
EMAIL_USER=your.email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Secret key to authorize Vercel Cron requests (optional but recommended)
CRON_SECRET=your_cron_secret_key

# Google Calendar Integration (Optional - can also be configured inside Admin UI)
GOOGLE_CALENDAR_ID=primary_or_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
